# Required in production. Provided by Vercel when the Neon database is linked.
DATABASE_URL=

# Test-only fallback for Playwright and local smoke checks without Postgres.
ALLOW_INMEM=

# Public site URL for metadata.
NEXT_PUBLIC_SITE_URL=https://www.adoptaboop.com

# Optional. Sends the waitlist confirmation email through Resend. When unset,
# the send is skipped and logged, and the signup still succeeds.
RESEND_API_KEY=

# Optional. Loads the TikTok Pixel and reports page views and signups to it.
# When unset, no TikTok code is loaded. /privacy already describes the pixel.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Optional. Salt for the hashed IPs in the rate_limits table.
RATE_LIMIT_SALT=
